# Admin password for /admin and /edit (defaults to 'exco2026' if unset — change it!)
ADMIN_PASSWORD=exco2026

# Optional: WhatsApp alerts via Green-API (reports, requests, low filament stock).
# Leave unset to disable — everything else keeps working.
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
WHATSAPP_GROUP_ID=

# Accounts service that verifies the ms_session cookie for pages with
# frontmatter `access: members`. The origin is read once at boot and never
# taken from requests. Unset means this default:
# ACCOUNTS_ORIGIN=http://127.0.0.1:3100

# Optional: comma-separated ITSC logins allowed to read `access: members` pages.
# Leave empty to admit any ITSC account that the accounts service recognises.
PROCUREMENT_ITSCS=
